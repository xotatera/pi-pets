{
  "name": "pi-pets",
  "version": "0.1.0",
  "description": "An original animated Pi companion for the Pi terminal agent",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/",
    "assets/",
    "README.md"
  ],
  "scripts": {
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "assets:extract": "node scripts/extract-assets.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "sharp": "0.35.5"
  }
}
